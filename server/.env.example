PORT=5000
NODE_ENV=production
ADMIN_EMAIL=sumantd9458@gmail.com

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas for Production)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/tradejourn?retryWrites=true&w=majority&maxPoolSize=50

# ------------------------------------------------------------------------------
# 2. JWT SECURITY & SESSION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_generated_via_crypto
JWT_EXPIRE=30d

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND DOMAIN
# ------------------------------------------------------------------------------
CLIENT_URL=https://your-production-domain.com

# ------------------------------------------------------------------------------
# 4. AI TRADING COACH PROVIDERS (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
OPENAI_API_KEY=your_optional_openai_api_key

# ------------------------------------------------------------------------------
# 5. TWILIO OTP & SMS DELIVERY (Production 2FA / Password Reset)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & EMAIL OTP (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
EMAIL_FROM="TradeJourn Security" <no-reply@yourdomain.com>

# ------------------------------------------------------------------------------
# 7. METATRADER 5 (MT5) INTEGRATION CONFIGURATION & FEATURE FLAG
# ------------------------------------------------------------------------------
MT5_INTEGRATION_ENABLED=true
MT5_MAX_CLOCK_DRIFT_SEC=30
MT5_HEARTBEAT_TIMEOUT_SEC=30

# ------------------------------------------------------------------------------
# 8. EXTERNAL MARKET DATA PROVIDERS (Forex, Metals, Crypto, Indices)
# ------------------------------------------------------------------------------
# Crypto feeds (BTCUSD, ETHUSD, SOLUSD) connect directly to Binance Spot Public REST API (24/7 Live, no API key required).
# Forex, Metals (Gold/Silver), and Indices use Twelve Data for institutional sub-second quotes and historical OHLC klines.
# Obtain your free API key at https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Optional: Alpha Vantage API Key (Alternative institutional provider)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# NOTE: When TWELVE_DATA_API_KEY is omitted, TradeJourn transparently uses the public delayed market feed (~15m delayed)
# and clearly labels all quotes as DELAYED. TradeJourn never fabricates live market prices.
